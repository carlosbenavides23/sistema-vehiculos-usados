# Copia este archivo como .env, introduce credenciales locales y nunca lo confirmes.
# Obtén la cadena desde Supabase → Connect → Transaction Pooler.
# Conserva sslmode=require en la cadena; el driver también fuerza TLS.
DATABASE_URL=

# URL pública del proyecto; la clave de servicio es secreta y solo va en Flask.
SUPABASE_URL=https://rtcygltmrtulyeezaaac.supabase.co
# Clave pública necesaria para solicitar Auth desde el servidor Flask.
SUPABASE_PUBLISHABLE_KEY=
# Alternativa heredada si el proyecto aún usa la clave anon JWT.
SUPABASE_ANON_KEY=
# Preferida: clave secreta moderna sb_secret_..., exclusivamente del servidor.
SUPABASE_SECRET_KEY=
# Alternativa heredada service_role JWT, si no se configura SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Genera una clave aleatoria localmente; no reutilices la del ejemplo.
FLASK_SECRET_KEY=

# Guarda aquí un hash Werkzeug scrypt, nunca la contraseña en texto plano.
ADMIN_PASSWORD_HASH=

# false para desarrollo local HTTP; true detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# Habilitar únicamente para PostgreSQL local en loopback, nunca en Vercel.
ALLOW_LOCAL_DATABASE=false

# true bloquea administración y escrituras. Preview siempre fuerza solo lectura,
# aunque esta variable o la configuración Flask indiquen false.
APP_READ_ONLY=false

# V7 permanece deshabilitada por defecto en todos los entornos.
USER_AUTH_ENABLED=false
# Segunda autorización, exclusivamente para Vercel Production. No reemplaza
# USER_AUTH_ENABLED ni la validación de configuración y migraciones.
V7_PRODUCTION_ENABLED=false

# Chat anónimo desactivado por defecto; requiere autorización para habilitarlo.
CHAT_ENABLED=false
