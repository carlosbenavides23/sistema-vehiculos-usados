# Copia este archivo como .env, introduce credenciales locales y nunca lo confirmes.
# Obtén la cadena desde Supabase → Connect → Transaction Pooler.
# Conserva sslmode=require en la cadena; el driver también fuerza TLS.
DATABASE_URL=

# URL pública del proyecto; la clave de servicio es secreta y solo va en Flask.
SUPABASE_URL=https://rtcygltmrtulyeezaaac.supabase.co
# Preferida: clave secreta moderna sb_secret_..., exclusivamente del servidor.
SUPABASE_SECRET_KEY=
# Alternativa heredada service_role JWT, si no se configura SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Genera una clave aleatoria localmente; no reutilices la del ejemplo.
FLASK_SECRET_KEY=

# Guarda aquí un hash Werkzeug scrypt, nunca la contraseña en texto plano.
ADMIN_PASSWORD_HASH=

# false para desarrollo local HTTP; true detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# Habilitar únicamente para PostgreSQL local en loopback, nunca en Vercel.
ALLOW_LOCAL_DATABASE=false

# true bloquea la administración y las escrituras. Vercel Preview es siempre
# de solo lectura en esta entrega, independientemente de este valor.
APP_READ_ONLY=false
